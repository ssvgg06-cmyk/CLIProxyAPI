# Git and GitHub folders
.git/*
.github/*

# Docker and CI/CD related files
docker-compose.yml
.dockerignore
.gitignore
.goreleaser.yml
Dockerfile

# Documentation and license
docs/*
README.md
README_CN.md
LICENSE

# Runtime data folders (should be mounted as volumes)
auths/*
logs/*
conv/*
config.yaml

# Deployment secrets must never enter a Docker build context or layer cache.
.env
.env.*
**/.env
**/.env.*
pool/secrets/
**/secrets/
**/secrets/**

# Persistent pool state can contain real Request IDs and must stay in volumes.
pool/state/
**/pool-state.json
**/newapi-log-cache.json.gz

